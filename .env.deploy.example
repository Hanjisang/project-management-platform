# 复制为 .env.deploy 后，必须替换所有密码与 JWT_SECRET。
MYSQL_ROOT_PASSWORD=replace_with_a_strong_mysql_root_password
MYSQL_PASSWORD=replace_with_a_strong_app_database_password
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_32_characters

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace_with_a_strong_initial_admin_password
DEFAULT_ADMIN_DISPLAY_NAME=系统管理员

APP_PORT=3030
MYSQL_PORT=3306

# 可在钉钉应用创建完成后填写。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_REDIRECT_URI=

# 禅道 API v2 任务同步（Token 仅保存在服务器）
ZENTAO_BASE_URL=
ZENTAO_TOKEN=
ZENTAO_EXECUTION_ID=
ZENTAO_ASSIGNED_TO=
ZENTAO_TASK_TYPE=devel
