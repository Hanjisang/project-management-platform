# Copy to .env.deploy and replace every required value before deployment.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-database-password
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-password
ADMIN_DISPLAY_NAME=系统管理员
WEB_PORT=8080
COOKIE_SECURE=true
CORS_ORIGIN=https://pmp.example.com
TRUST_PROXY_HOPS=1

# Optional OpenAI-compatible analysis. Disabled safely when unconfigured.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini

# Optional DingTalk callback integration.
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_SIGNING_SECRET=
DINGTALK_STREAM_ENABLED=false

# Optional Zentao task synchronization.
ZENTAO_BASE_URL=
ZENTAO_TOKEN=
