generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
  DEPARTED
}

enum ProjectStatus {
  DRAFT
  NOT_STARTED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProjectHealth {
  NORMAL
  WARNING
  HIGH_RISK
}

enum ProjectRole {
  PROJECT_MANAGER
  IMPLEMENTER
  DEVELOPER
  PRODUCT
  TESTER
  VIEWER
}

enum SopVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SourceType {
  MANUAL
  MESSAGE
  ISSUE
  SOP
  ZENTAO
}

enum WorkItemSourceType {
  SOP
  MANUAL
  CHANGE
}

enum DeliverableReviewMode {
  AI_WITH_HUMAN_OVERRIDE
  AI_THEN_HUMAN_REQUIRED
  HUMAN_ONLY
}

enum DocumentReviewType {
  AI
  HUMAN
}

enum DocumentVersionReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

enum ReviewFindingSeverity {
  INFO
  WARNING
  ERROR
}

enum AiReviewJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProjectChangeStatus {
  DRAFT
  ANALYZING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLYING
  APPLIED
  CANCELLED
  FAILED
}

enum ProjectChangeType {
  SCHEDULE
  SCOPE
  REQUIREMENT
  DELIVERABLE
  ACCEPTANCE
  TECHNICAL
  RESOURCE
  MIXED
}

enum ProjectChangeSource {
  CUSTOMER
  INTERNAL_PRODUCT
  R_AND_D
  THIRD_PARTY
  ENVIRONMENT
  POLICY
  OTHER
}

enum ProjectChangeOperationType {
  PROJECT_COMPLETION_DATE_CHANGE
  ADD_STAGE
  UPDATE_STAGE
  CANCEL_STAGE
  ADD_WORK_ITEM
  UPDATE_WORK_ITEM
  CANCEL_WORK_ITEM
  ADD_CHECKLIST
  UPDATE_CHECKLIST
  CANCEL_CHECKLIST
  ADD_DELIVERABLE
  UPDATE_DELIVERABLE
  CANCEL_DELIVERABLE
  DELIVERABLE_NEEDS_REVISION
  CHANGE_OWNER
  CHANGE_ACCEPTANCE_CRITERIA
}

enum NotificationType {
  PLAN_ADJUSTED
  CHANGE_APPROVAL_REQUIRED
  CHANGE_APPROVED
  CHANGE_REJECTED
  CHANGE_APPLIED
  DELIVERABLE_AI_REVIEW_COMPLETED
  DELIVERABLE_HUMAN_REVIEW_REQUIRED
  DELIVERABLE_REJECTED
  WORK_ITEM_OVERDUE
}

enum IssueType {
  ISSUE
  RISK
  CHANGE
  BLOCKER
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  PROCESSING
  WAITING
  RESOLVED
  CLOSED
}

enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageSource {
  MANUAL
  DINGTALK_BOT
  DINGTALK_STREAM
  DAILY_REPORT
  IMPORT
}

enum MessageStatus {
  RECEIVED
  ANALYZED
  PENDING_CONFIRMATION
  CONFIRMED
  IGNORED
  FAILED
}

enum AnalysisStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PendingActionType {
  CREATE_TASK
  CREATE_ISSUE
  UPDATE_PROGRESS
  CREATE_NOTE
  CREATE_RISK
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum KnowledgeStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  ERROR
}

enum SyncStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id                   String                   @id @default(cuid()) @db.VarChar(30)
  username             String                   @unique @db.VarChar(80)
  passwordHash         String                   @map("password_hash") @db.VarChar(255)
  displayName          String                   @map("display_name") @db.VarChar(120)
  email                String?                  @db.VarChar(190)
  status               UserStatus               @default(ACTIVE)
  failedLoginAttempts  Int                      @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?                @map("locked_until")
  lastLoginAt          DateTime?                @map("last_login_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  deletedAt            DateTime?                @map("deleted_at")
  roles                UserRole[]
  refreshTokens        RefreshToken[]
  managedProjects      Project[]                @relation("ProjectManager")
  approvedProjects     Project[]                @relation("ProjectApprover")
  memberships          ProjectMember[]
  ownedWorkItems       ProjectWorkItem[]        @relation("WorkItemOwner")
  createdWorkItems     ProjectWorkItem[]        @relation("WorkItemCreator")
  ownedIssues          Issue[]                  @relation("IssueOwner")
  createdIssues        Issue[]                  @relation("IssueCreator")
  createdDocuments     Document[]               @relation("DocumentCreator")
  uploadedVersions     DocumentVersion[]        @relation("DocumentUploader")
  uploadedSopTemplates SopDeliverableTemplate[] @relation("SopTemplateUploader")
  reviews              DocumentVersionReview[]  @relation("DocumentVersionReviewer")
  createdMessages      Message[]                @relation("MessageCreator")
  confirmedActions     PendingAction[]          @relation("ActionConfirmer")
  dailyReports         DailyReport[]            @relation("DailyReporter")
  weeklyReports        WeeklyReport[]           @relation("WeeklyCreator")
  authoredArticles     KnowledgeArticle[]       @relation("KnowledgeAuthor")
  reviewedArticles     KnowledgeArticle[]       @relation("KnowledgeReviewer")
  auditLogs            AuditLog[]
  notes                ProjectNote[]            @relation("ProjectNoteCreator")
  requestedChanges     ProjectChangeRequest[]   @relation("ProjectChangeRequester")
  approvedChanges      ProjectChangeRequest[]   @relation("ProjectChangeApprover")
  createdBaselines     ProjectBaseline[]        @relation("ProjectBaselineCreator")
  adjustments          ProjectAdjustmentLog[]   @relation("ProjectAdjustmentOperator")
  notifications        Notification[]
  completedChecklists  ProjectChecklistItem[]   @relation("ChecklistCompleter")

  @@index([status, deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid()) @db.VarChar(30)
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid()) @db.VarChar(30)
  code        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.VarChar(30)
  roleId     String   @map("role_id") @db.VarChar(30)
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(30)
  permissionId String     @map("permission_id") @db.VarChar(30)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid()) @db.VarChar(30)
  userId    String    @map("user_id") @db.VarChar(30)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Project {
  id                String                 @id @default(cuid()) @db.VarChar(30)
  code              String                 @unique @db.VarChar(50)
  name              String                 @db.VarChar(200)
  customerName      String                 @map("customer_name") @db.VarChar(200)
  managerUserId     String                 @map("manager_user_id") @db.VarChar(30)
  approverUserId    String?                @map("approver_user_id") @db.VarChar(30)
  status            ProjectStatus          @default(NOT_STARTED)
  health            ProjectHealth          @default(NORMAL)
  healthOverride    ProjectHealth?         @map("health_override")
  plannedStartDate  DateTime?              @map("planned_start_date") @db.Date
  plannedGoLiveDate DateTime?              @map("planned_go_live_date") @db.Date
  actualStartDate   DateTime?              @map("actual_start_date")
  actualGoLiveDate  DateTime?              @map("actual_go_live_date")
  progress          Int                    @default(0) @db.UnsignedTinyInt
  description       String?                @db.Text
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  deletedAt         DateTime?              @map("deleted_at")
  manager           User                   @relation("ProjectManager", fields: [managerUserId], references: [id], onDelete: Restrict)
  approver          User?                  @relation("ProjectApprover", fields: [approverUserId], references: [id], onDelete: Restrict)
  members           ProjectMember[]
  plans             ProjectPlan[]
  workItems         ProjectWorkItem[]
  issues            Issue[]
  documents         Document[]
  messages          Message[]
  dailyReports      DailyReport[]
  weeklyReports     WeeklyReport[]
  knowledgeArticles KnowledgeArticle[]
  notes             ProjectNote[]
  changeRequests    ProjectChangeRequest[]
  baselines         ProjectBaseline[]
  adjustmentLogs    ProjectAdjustmentLog[]
  notifications     Notification[]

  @@index([managerUserId])
  @@index([approverUserId])
  @@index([status, deletedAt])
  @@index([health, plannedGoLiveDate])
  @@map("projects")
}

model ProjectMember {
  projectId   String      @map("project_id") @db.VarChar(30)
  userId      String      @map("user_id") @db.VarChar(30)
  projectRole ProjectRole @map("project_role")
  joinedAt    DateTime    @default(now()) @map("joined_at")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model SopTemplate {
  id          String       @id @default(cuid()) @db.VarChar(30)
  code        String       @unique @db.VarChar(80)
  name        String       @db.VarChar(200)
  description String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  versions    SopVersion[]

  @@index([deletedAt])
  @@map("sop_templates")
}

model SopVersion {
  id           String           @id @default(cuid()) @db.VarChar(30)
  templateId   String           @map("template_id") @db.VarChar(30)
  version      String           @db.VarChar(40)
  status       SopVersionStatus @default(DRAFT)
  description  String?          @db.Text
  publishedAt  DateTime?        @map("published_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  template     SopTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stages       SopStage[]
  projectPlans ProjectPlan[]

  @@unique([templateId, version])
  @@index([status, publishedAt])
  @@map("sop_versions")
}

model SopStage {
  id                  String         @id @default(cuid()) @db.VarChar(30)
  stableKey           String         @default(cuid()) @map("stable_key") @db.VarChar(30)
  sopVersionId        String         @map("sop_version_id") @db.VarChar(30)
  name                String         @db.VarChar(200)
  description         String?        @db.Text
  sortOrder           Int            @map("sort_order")
  defaultDurationDays Int            @default(1) @map("default_duration_days")
  weight              Int            @default(0) @db.UnsignedTinyInt
  version             SopVersion     @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  tasks               SopTask[]
  projectStages       ProjectStage[] @relation("PlanStageSource")

  @@unique([sopVersionId, sortOrder])
  @@unique([sopVersionId, stableKey])
  @@index([sopVersionId])
  @@map("sop_stages")
}

model SopTask {
  id                  String             @id @default(cuid()) @db.VarChar(30)
  stableKey           String             @default(cuid()) @map("stable_key") @db.VarChar(30)
  stageId             String             @map("stage_id") @db.VarChar(30)
  name                String             @db.VarChar(200)
  description         String?            @db.Text
  sortOrder           Int                @map("sort_order")
  defaultDurationDays Int                @default(1) @map("default_duration_days")
  weight              Int                @default(0) @db.UnsignedTinyInt
  required            Boolean            @default(true)
  stage               SopStage           @relation(fields: [stageId], references: [id], onDelete: Cascade)
  checklistItems      SopChecklistItem[]
  deliverables        SopDeliverable[]
  projectWorkItems    ProjectWorkItem[]  @relation("WorkItemSource")

  @@unique([stageId, sortOrder])
  @@unique([stageId, stableKey])
  @@index([stageId])
  @@map("sop_tasks")
}

model SopDeliverable {
  id                     String                          @id @default(cuid()) @db.VarChar(30)
  sopTaskId              String                          @map("sop_task_id") @db.VarChar(30)
  stableKey              String                          @default(cuid()) @map("stable_key") @db.VarChar(30)
  name                   String                          @db.VarChar(200)
  description            String?                         @db.Text
  required               Boolean                         @default(true)
  sortOrder              Int                             @map("sort_order")
  reviewMode             DeliverableReviewMode           @default(HUMAN_ONLY) @map("review_mode")
  aiReviewEnabled        Boolean                         @default(false) @map("ai_review_enabled")
  aiAutoApproveThreshold Int?                            @map("ai_auto_approve_threshold") @db.UnsignedTinyInt
  aiReviewInstruction    String?                         @map("ai_review_instruction") @db.Text
  createdAt              DateTime                        @default(now()) @map("created_at")
  updatedAt              DateTime                        @updatedAt @map("updated_at")
  task                   SopTask                         @relation(fields: [sopTaskId], references: [id], onDelete: Cascade)
  templates              SopDeliverableTemplate[]
  reviewCriteria         SopDeliverableReviewCriterion[]
  planDeliverables       ProjectDeliverable[]            @relation("ProjectDeliverableSource")

  @@unique([sopTaskId, stableKey])
  @@unique([sopTaskId, sortOrder])
  @@index([sopTaskId])
  @@map("sop_deliverables")
}

model SopDeliverableReviewCriterion {
  id              String                              @id @default(cuid()) @db.VarChar(30)
  deliverableId   String                              @map("deliverable_id") @db.VarChar(30)
  stableKey       String                              @default(cuid()) @map("stable_key") @db.VarChar(30)
  name            String                              @db.VarChar(200)
  description     String?                             @db.Text
  required        Boolean                             @default(true)
  weight          Int                                 @default(0) @db.UnsignedTinyInt
  sortOrder       Int                                 @map("sort_order")
  createdAt       DateTime                            @default(now()) @map("created_at")
  updatedAt       DateTime                            @updatedAt @map("updated_at")
  deliverable     SopDeliverable                      @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  projectCriteria ProjectDeliverableReviewCriterion[] @relation("ProjectCriterionSource")

  @@unique([deliverableId, stableKey])
  @@unique([deliverableId, sortOrder])
  @@index([deliverableId])
  @@map("sop_deliverable_review_criteria")
}

model SopDeliverableTemplate {
  id               String                       @id @default(cuid()) @db.VarChar(30)
  deliverableId    String                       @map("deliverable_id") @db.VarChar(30)
  fileName         String                       @map("file_name") @db.VarChar(255)
  objectKey        String                       @unique @map("object_key") @db.VarChar(500)
  mimeType         String                       @map("mime_type") @db.VarChar(150)
  size             BigInt                       @db.UnsignedBigInt
  checksum         String                       @db.VarChar(64)
  uploadedById     String                       @map("uploaded_by_id") @db.VarChar(30)
  createdAt        DateTime                     @default(now()) @map("created_at")
  deliverable      SopDeliverable               @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  uploader         User                         @relation("SopTemplateUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  projectTemplates ProjectDeliverableTemplate[] @relation("ProjectTemplateSource")

  @@index([deliverableId, createdAt])
  @@index([uploadedById])
  @@map("sop_deliverable_templates")
}

model SopChecklistItem {
  id        String  @id @default(cuid()) @db.VarChar(30)
  stableKey String  @default(cuid()) @map("stable_key") @db.VarChar(30)
  taskId    String  @map("task_id") @db.VarChar(30)
  name      String  @db.VarChar(200)
  sortOrder Int     @map("sort_order")
  required  Boolean @default(true)
  task      SopTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, sortOrder])
  @@unique([taskId, stableKey])
  @@index([taskId])
  @@map("sop_checklist_items")
}

model ProjectPlan {
  id                 String         @id @default(cuid()) @db.VarChar(30)
  projectId          String         @map("project_id") @db.VarChar(30)
  sourceSopVersionId String?        @map("source_sop_version_id") @db.VarChar(30)
  name               String         @db.VarChar(200)
  progress           Int            @default(0) @db.UnsignedTinyInt
  generatedAt        DateTime       @default(now()) @map("generated_at")
  syncedAt           DateTime?      @map("synced_at")
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceVersion      SopVersion?    @relation(fields: [sourceSopVersionId], references: [id], onDelete: Restrict)
  stages             ProjectStage[]

  @@unique([projectId])
  @@index([sourceSopVersionId])
  @@map("project_plans")
}

model ProjectStage {
  id               String                 @id @default(cuid()) @db.VarChar(30)
  planId           String                 @map("plan_id") @db.VarChar(30)
  sourceStageId    String?                @map("source_stage_id") @db.VarChar(30)
  sourceStageKey   String?                @map("source_stage_key") @db.VarChar(30)
  name             String                 @db.VarChar(200)
  description      String?                @db.Text
  sortOrder        Int                    @map("sort_order")
  weight           Int                    @default(0) @db.UnsignedTinyInt
  progress         Int                    @default(0) @db.UnsignedTinyInt
  plannedStartDate DateTime?              @map("planned_start_date") @db.Date
  plannedEndDate   DateTime?              @map("planned_end_date") @db.Date
  actualStartDate  DateTime?              @map("actual_start_date")
  actualEndDate    DateTime?              @map("actual_end_date")
  isCustom         Boolean                @default(false) @map("is_custom")
  plan             ProjectPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  sourceStage      SopStage?              @relation("PlanStageSource", fields: [sourceStageId], references: [id], onDelete: SetNull)
  workItems        ProjectWorkItem[]
  baselineStages   ProjectBaselineStage[]

  @@unique([planId, sortOrder])
  @@index([planId])
  @@index([sourceStageId])
  @@index([sourceStageKey])
  @@map("project_stages")
}

model ProjectWorkItem {
  id                         String                    @id @default(cuid()) @db.VarChar(30)
  projectId                  String                    @map("project_id") @db.VarChar(30)
  planStageId                String                    @map("plan_stage_id") @db.VarChar(30)
  sourceSopTaskId            String?                   @map("source_sop_task_id") @db.VarChar(30)
  sourceSopTaskKey           String?                   @map("source_sop_task_key") @db.VarChar(30)
  parentWorkItemId           String?                   @map("parent_work_item_id") @db.VarChar(30)
  name                       String                    @db.VarChar(240)
  description                String?                   @db.Text
  ownerUserId                String?                   @map("owner_user_id") @db.VarChar(30)
  status                     TaskStatus                @default(TODO)
  priority                   TaskPriority              @default(MEDIUM)
  plannedStartDate           DateTime?                 @map("planned_start_date") @db.Date
  plannedEndDate             DateTime?                 @map("planned_end_date") @db.Date
  actualStartDate            DateTime?                 @map("actual_start_date")
  actualEndDate              DateTime?                 @map("actual_end_date")
  progress                   Int                       @default(0) @db.UnsignedTinyInt
  required                   Boolean                   @default(true)
  sourceType                 WorkItemSourceType        @default(MANUAL) @map("source_type")
  sortOrder                  Int                       @map("sort_order")
  weight                     Int                       @default(0) @db.UnsignedTinyInt
  isCustom                   Boolean                   @default(false) @map("is_custom")
  cancelledByChangeRequestId String?                   @map("cancelled_by_change_request_id") @db.VarChar(30)
  createdById                String                    @map("created_by_id") @db.VarChar(30)
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  project                    Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage                      ProjectStage              @relation(fields: [planStageId], references: [id], onDelete: Cascade)
  sourceSopTask              SopTask?                  @relation("WorkItemSource", fields: [sourceSopTaskId], references: [id], onDelete: SetNull)
  parent                     ProjectWorkItem?          @relation("WorkItemHierarchy", fields: [parentWorkItemId], references: [id], onDelete: SetNull)
  children                   ProjectWorkItem[]         @relation("WorkItemHierarchy")
  owner                      User?                     @relation("WorkItemOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  creator                    User                      @relation("WorkItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledByChangeRequest   ProjectChangeRequest?     @relation("CancelledWorkItems", fields: [cancelledByChangeRequestId], references: [id], onDelete: SetNull)
  checklistItems             ProjectChecklistItem[]
  deliverables               ProjectDeliverable[]
  documents                  Document[]
  zentaoSync                 ZentaoTaskSync?
  baselineWorkItems          ProjectBaselineWorkItem[]

  @@unique([planStageId, sortOrder])
  @@index([projectId, status])
  @@index([projectId, plannedEndDate])
  @@index([planStageId])
  @@index([sourceSopTaskId])
  @@index([sourceSopTaskKey])
  @@index([parentWorkItemId])
  @@index([ownerUserId, status])
  @@index([cancelledByChangeRequestId])
  @@map("project_work_items")
}

model ProjectDeliverable {
  id                     String                              @id @default(cuid()) @db.VarChar(30)
  workItemId             String                              @map("work_item_id") @db.VarChar(30)
  sourceDeliverableId    String?                             @map("source_deliverable_id") @db.VarChar(30)
  sourceDeliverableKey   String?                             @map("source_deliverable_key") @db.VarChar(30)
  name                   String                              @db.VarChar(200)
  description            String?                             @db.Text
  required               Boolean                             @default(true)
  sortOrder              Int                                 @map("sort_order")
  reviewMode             DeliverableReviewMode               @default(HUMAN_ONLY) @map("review_mode")
  aiAutoApproveThreshold Int?                                @map("ai_auto_approve_threshold") @db.UnsignedTinyInt
  aiReviewInstruction    String?                             @map("ai_review_instruction") @db.Text
  needsRevision          Boolean                             @default(false) @map("needs_revision")
  revisionReason         String?                             @map("revision_reason") @db.Text
  isCustom               Boolean                             @default(false) @map("is_custom")
  createdAt              DateTime                            @default(now()) @map("created_at")
  updatedAt              DateTime                            @updatedAt @map("updated_at")
  workItem               ProjectWorkItem                     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  sourceDeliverable      SopDeliverable?                     @relation("ProjectDeliverableSource", fields: [sourceDeliverableId], references: [id], onDelete: SetNull)
  templates              ProjectDeliverableTemplate[]
  documents              Document[]
  reviewCriteria         ProjectDeliverableReviewCriterion[]
  baselineDeliverables   ProjectBaselineDeliverable[]

  @@unique([workItemId, sourceDeliverableKey])
  @@unique([workItemId, sortOrder])
  @@index([workItemId])
