  projectId            String          @map("project_id") @db.VarChar(30)
  operatorUserId       String          @map("operator_user_id") @db.VarChar(30)
  adjustmentType       String          @map("adjustment_type") @db.VarChar(80)
  entityType           String          @map("entity_type") @db.VarChar(80)
  entityId             String          @map("entity_id") @db.VarChar(30)
  beforeSummary        String          @map("before_summary") @db.Text
  afterSummary         String          @map("after_summary") @db.Text
  reason               String          @db.Text
  baselineId           String          @map("baseline_id") @db.VarChar(30)
  completionDateBefore DateTime?       @map("completion_date_before") @db.Date
  completionDateAfter  DateTime?       @map("completion_date_after") @db.Date
  changeRate           Decimal?        @map("change_rate") @db.Decimal(8, 4)
  createdAt            DateTime        @default(now()) @map("created_at")
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operator             User            @relation("ProjectAdjustmentOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  baseline             ProjectBaseline @relation(fields: [baselineId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([baselineId])
  @@map("project_adjustment_logs")
}

model Notification {
  id           String           @id @default(cuid()) @db.VarChar(30)
  userId       String           @map("user_id") @db.VarChar(30)
  projectId    String?          @map("project_id") @db.VarChar(30)
  type         NotificationType
  title        String           @db.VarChar(240)
  content      String           @db.Text
  resourceType String           @map("resource_type") @db.VarChar(100)
  resourceId   String           @map("resource_id") @db.VarChar(30)
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([projectId, type])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(cuid()) @db.VarChar(30)
  userId       String?  @map("user_id") @db.VarChar(30)
  action       String   @db.VarChar(120)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.VarChar(80)
  requestId    String   @map("request_id") @db.VarChar(80)
  ipAddress    String?  @map("ip_address") @db.VarChar(80)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  before       Json?
  after        Json?
  createdAt    DateTime @default(now()) @map("created_at")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
  @@map("audit_logs")
}

model ZentaoTaskSync {
  id             String          @id @default(cuid()) @db.VarChar(30)
  workItemId     String          @unique @map("work_item_id") @db.VarChar(30)
  externalTaskId String?         @map("external_task_id") @db.VarChar(120)
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(120)
  syncStatus     SyncStatus      @default(PENDING) @map("sync_status")
  lastSyncedAt   DateTime?       @map("last_synced_at")
  lastError      String?         @map("last_error") @db.Text
  workItem       ProjectWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([syncStatus, lastSyncedAt])
  @@map("zentao_task_syncs")
}

model IntegrationReplayNonce {
  id        String   @id @default(cuid()) @db.VarChar(30)
  provider  String   @db.VarChar(80)
  nonce     String   @db.VarChar(190)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, nonce])
  @@index([expiresAt])
  @@map("integration_replay_nonces")
}

model StorageCleanupJob {
  id          String    @id @default(cuid()) @db.VarChar(30)
  objectKey   String    @unique @map("object_key") @db.VarChar(500)
  reason      String    @db.VarChar(200)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([completedAt, attempts])
  @@map("storage_cleanup_jobs")
}

model ProjectNote {
  id              String   @id @default(cuid()) @db.VarChar(30)
  projectId       String   @map("project_id") @db.VarChar(30)
  content         String   @db.Text
  sourceMessageId String?  @map("source_message_id") @db.VarChar(30)
  createdById     String   @map("created_by_id") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("ProjectNoteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([createdById])
  @@index([sourceMessageId])
  @@map("project_notes")
}
