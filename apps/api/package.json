    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.4.0",
    "@pmp/shared-constants": "*",
    "@pmp/shared-types": "*",
    "@pmp/shared-utils": "*",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
