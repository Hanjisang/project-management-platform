{
  "name": "project-management-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Medical information implementation project management platform V2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "officeparser": {
      "pdfjs-dist": "5.5.207"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @pmp/api\" \"npm run dev -w @pmp/web\"",
    "build": "npm run build -w @pmp/shared-types && npm run build -w @pmp/shared-constants && npm run build -w @pmp/shared-utils && npm run build -w @pmp/api && npm run build -w @pmp/web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "vitest run packages apps --exclude '**/*.integration-spec.ts' --exclude '**/*.e2e-spec.ts'",
    "test:integration": "vitest run --config apps/api/vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @pmp/api",
    "db:migrate": "npm run db:migrate -w @pmp/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @pmp/api",
    "db:seed": "npm run db:seed -w @pmp/api",
    "db:seed:demo": "npm run db:seed:demo -w @pmp/api",
    "prepare": "npm run db:generate --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pdfjs-dist": "5.5.207"
  }
}
