# Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
COOKIE_SECURE=false
LOG_LEVEL=info

# MySQL 8+
DATABASE_URL=mysql://pmp:pmp_change_me@localhost:3306/pmp

# Use independent random values with at least 32 characters
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
LOGIN_MAX_ATTEMPTS=5

# Base seed administrator (never use this sample password in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password-now
ADMIN_DISPLAY_NAME=系统管理员

# Storage: local is implemented; s3 is an extension point
STORAGE_PROVIDER=local
STORAGE_PATH=./apps/api/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OpenAI-compatible AI. The system starts normally when disabled.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
# Test only; production ignores fake providers
AI_FAKE_ENABLED=false

# DingTalk secure active entry points
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_SIGNING_SECRET=
DINGTALK_STREAM_ENABLED=false

# Zentao
ZENTAO_BASE_URL=
ZENTAO_TOKEN=
