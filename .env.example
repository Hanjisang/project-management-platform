PORT=3030

# MySQL：填写后可执行 database/schema.sql 并开始接入正式持久化。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pis_delivery
MYSQL_USER=pis_app
MYSQL_PASSWORD=change_me
MYSQL_SSL=false

# 生产环境请替换为至少 32 位的随机值，且不要提交 .env 文件。
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# 钉钉扫码登录：待创建企业内部应用后填写。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_REDIRECT_URI=http://localhost:3030/api/auth/dingtalk/callback

# ZenTao API v2 task synchronization
ZENTAO_BASE_URL=
ZENTAO_TOKEN=
ZENTAO_EXECUTION_ID=
ZENTAO_ASSIGNED_TO=
ZENTAO_TASK_TYPE=devel
